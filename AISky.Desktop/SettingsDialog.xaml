<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AISky_Desktop.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="应用设置"
    PrimaryButtonText="保存设置"
    CloseButtonText="取消"
    DefaultButton="Primary"
    Closing="SettingsDialog_Closing"
    Loaded="SettingsDialog_Loaded"
    mc:Ignorable="d">

    <ScrollViewer MaxHeight="660" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="500" Spacing="16">
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="42"
                        Height="42"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Glyph="&#xE895;" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="调整地图与后台行为" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="显示选项会立即应用；后台任务失败不会中断地图浏览。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock
                    Margin="2,0"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="地图显示" />
                <Slider
                    x:Name="LayerOpacitySlider"
                    AutomationProperties.Name="气象图层透明度"
                    Header="气象图层透明度"
                    Maximum="100"
                    Minimum="35"
                    StepFrequency="5" />
                <ToggleSwitch
                    x:Name="MapGridToggle"
                    AutomationProperties.Name="显示经纬网和经纬度"
                    Header="经纬网与经纬度"
                    OffContent="隐藏"
                    OnContent="显示" />
                <ToggleSwitch
                    x:Name="MapPlacesToggle"
                    AutomationProperties.Name="显示城市标注"
                    Header="城市标注"
                    OffContent="隐藏"
                    OnContent="显示" />
                <ToggleSwitch
                    x:Name="WindAnimationToggle"
                    AutomationProperties.Name="显示风场粒子动画"
                    Header="风场粒子"
                    OffContent="关闭"
                    OnContent="显示" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="设置会立即应用到地图，并在下次启动时保留。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="12">
                <TextBlock
                    Margin="2,0"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="数据存储" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="默认保存在软件目录的 AISkyData 文件夹。切换后会迁移预报数据并自动重新启动。"
                    TextWrapping="Wrap" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="DataRootPathTextBox"
                        AutomationProperties.Name="AISky 数据存放目录"
                        Header="当前数据目录"
                        IsReadOnly="True" />
                    <Button
                        Grid.Column="1"
                        Margin="0,24,0,0"
                        MinWidth="100"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="选择 AISky 数据目录"
                        Click="SelectDataRootButton_Click"
                        Content="选择文件夹" />
                </Grid>
                <InfoBar
                    x:Name="DataRootInfo"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational" />
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="12">
                <TextBlock
                    Margin="2,0"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="自动同步" />
                <ToggleSwitch
                    x:Name="AutoSyncToggle"
                    AutomationProperties.Name="每三小时自动同步"
                    Header="每 3 小时检查最新起报"
                    OffContent="已暂停"
                    OnContent="后台运行" />
                <ComboBox
                    x:Name="ForecastHoursPicker"
                    AutomationProperties.Name="自动同步预报范围"
                    Header="每次同步的预报范围"
                    SelectedIndex="5">
                    <ComboBoxItem Content="仅最新时刻（+0h）" Tag="0" />
                    <ComboBoxItem Content="未来 24 小时" Tag="24" />
                    <ComboBoxItem Content="未来 48 小时" Tag="48" />
                    <ComboBoxItem Content="未来 72 小时" Tag="72" />
                    <ComboBoxItem Content="未来 7 天" Tag="168" />
                    <ComboBoxItem Content="未来 15 天" Tag="360" />
                </ComboBox>
                <PasswordBox
                    x:Name="DataAccessPasswordInput"
                    AutomationProperties.Name="自动同步使用的数据访问密码，可选"
                    Header="数据访问密码（可选）"
                    MaxLength="128"
                    PasswordRevealMode="Peek"
                    PlaceholderText="公开数据可留空；仅保存在本机" />
                <InfoBar
                    x:Name="CredentialInfo"
                    IsClosable="False"
                    IsOpen="False"
                    Message="公开数据无需密码；服务器要求验证时再填写。"
                    Severity="Warning" />
                <ToggleSwitch
                    x:Name="KeepInTrayToggle"
                    AutomationProperties.Name="关闭窗口时在托盘运行"
                    Header="关闭主窗口后继续运行"
                    OffContent="直接退出"
                    OnContent="最小化到通知区" />
                <ToggleSwitch
                    x:Name="StartWithWindowsToggle"
                    AutomationProperties.Name="登录 Windows 后自动启动 AISky"
                    Header="登录 Windows 后自动启动"
                    OffContent="手动启动"
                    OnContent="在通知区启动" />
                <ToggleSwitch
                    x:Name="CheckUpdatesToggle"
                    AutomationProperties.Name="每六小时自动检查软件更新"
                    Header="每 6 小时后台检查软件更新"
                    OffContent="仅手动检查"
                    OnContent="发现后提醒" />
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="缓存保留" />
                    <TextBlock
                        x:Name="CacheSizeText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="正在统计…" />
                </Grid>
                <ComboBox
                    x:Name="RetentionPicker"
                    AutomationProperties.Name="缓存保留天数"
                    Header="自动清理起报时间早于"
                    SelectionChanged="RetentionPicker_SelectionChanged">
                    <ComboBoxItem Content="3 天" Tag="3" />
                    <ComboBoxItem Content="7 天" Tag="7" />
                    <ComboBoxItem Content="15 天" Tag="15" />
                    <ComboBoxItem Content="30 天" Tag="30" />
                    <ComboBoxItem Content="自定义" Tag="custom" />
                </ComboBox>
                <NumberBox
                    x:Name="CustomRetentionDays"
                    AutomationProperties.Name="自定义缓存保留天数"
                    Header="自定义天数"
                    Maximum="365"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact"
                    Visibility="Collapsed" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="立即维护本地缓存" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="只删除索引确认过期且位于 AISky 缓存目录内的数据"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="CleanupButton"
                        Grid.Column="1"
                        MinWidth="96"
                        AutomationProperties.Name="立即清理过期缓存"
                        Click="CleanupButton_Click"
                        Content="安全清理" />
                </Grid>
                <ProgressBar
                    x:Name="CleanupProgress"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
                <InfoBar
                    x:Name="CleanupInfo"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational" />
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid Margin="2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="AISky 智慧气象桌面平台" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="GitHub Release 更新组件已就绪" />
                </StackPanel>
                <TextBlock
                    x:Name="ApplicationVersionText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="版本 0.8.6" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
