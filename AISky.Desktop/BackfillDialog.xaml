<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="AISky_Desktop.BackfillDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="回溯下载预报数据"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="开始下载">

    <StackPanel Width="440" Spacing="14">
        <InfoBar
            IsClosable="False"
            IsIconVisible="True"
            IsOpen="True"
            Message="每个起报会按 3 小时间隔下载可用预报文件。长时间范围可能占用较多磁盘空间。"
            Severity="Informational" />

        <ComboBox
            x:Name="ModelPicker"
            AutomationProperties.Name="下载模型"
            Header="模型"
            SelectedIndex="0">
            <ComboBoxItem Content="AISky-Energy" />
            <ComboBoxItem Content="AISky-SDS" />
        </ComboBox>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="132" />
            </Grid.ColumnDefinitions>
            <CalendarDatePicker
                x:Name="StartDatePicker"
                AutomationProperties.Name="开始日期"
                DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                Header="开始时间（UTC）" />
            <ComboBox
                x:Name="StartTimePicker"
                Grid.Column="1"
                AutomationProperties.Name="开始固定时刻"
                Header="固定时刻"
                SelectedIndex="0" />
        </Grid>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="132" />
            </Grid.ColumnDefinitions>
            <CalendarDatePicker
                x:Name="EndDatePicker"
                AutomationProperties.Name="截止日期"
                DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                Header="截止时间（UTC）" />
            <ComboBox
                x:Name="EndTimePicker"
                Grid.Column="1"
                AutomationProperties.Name="截止固定时刻"
                Header="固定时刻"
                SelectedIndex="7" />
        </Grid>

        <PasswordBox
            x:Name="PasswordInput"
            AutomationProperties.Name="数据访问密码"
            Header="访问密码"
            MaxLength="128"
            PasswordRevealMode="Peek"
            PlaceholderText="请输入数据分享页访问密码" />

        <StackPanel x:Name="ProgressArea" Spacing="8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ProgressText"
                    Text="正在准备下载任务"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="ProgressValueText"
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="0%" />
            </Grid>
            <ProgressBar
                x:Name="DownloadProgress"
                AutomationProperties.Name="回溯下载进度"
                Maximum="100"
                Minimum="0" />
        </StackPanel>

        <InfoBar
            x:Name="ResultInfoBar"
            IsClosable="False"
            IsOpen="False" />
    </StackPanel>
</ContentDialog>
