<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="AISky_Desktop.BackfillDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="回溯下载预报数据"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="开始后台下载">

    <StackPanel Width="440" Spacing="14">
        <InfoBar
            IsClosable="False"
            IsIconVisible="True"
            IsOpen="True"
            Message="提交后将转入后台下载，可继续使用地图；进度与取消操作会显示在主界面状态区。"
            Severity="Informational" />

        <ComboBox
            x:Name="ModelPicker"
            AutomationProperties.Name="下载模型"
            Header="模型"
            SelectedIndex="0">
            <ComboBoxItem Content="AISky-Energy" />
            <ComboBoxItem Content="AISky-SDS" />
        </ComboBox>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="132" />
            </Grid.ColumnDefinitions>
            <CalendarDatePicker
                x:Name="StartDatePicker"
                AutomationProperties.Name="开始日期"
                DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                Header="开始时间（UTC）" />
            <ComboBox
                x:Name="StartTimePicker"
                Grid.Column="1"
                AutomationProperties.Name="开始固定时刻"
                Header="固定时刻"
                SelectedIndex="0" />
        </Grid>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="132" />
            </Grid.ColumnDefinitions>
            <CalendarDatePicker
                x:Name="EndDatePicker"
                AutomationProperties.Name="截止日期"
                DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                Header="截止时间（UTC）" />
            <ComboBox
                x:Name="EndTimePicker"
                Grid.Column="1"
                AutomationProperties.Name="截止固定时刻"
                Header="固定时刻"
                SelectedIndex="7" />
        </Grid>

        <PasswordBox
            x:Name="PasswordInput"
            AutomationProperties.Name="数据访问密码，可选"
            Header="访问密码（可选）"
            MaxLength="128"
            PasswordRevealMode="Peek"
            PlaceholderText="公开数据可留空" />

        <InfoBar
            x:Name="ResultInfoBar"
            IsClosable="False"
            IsOpen="False" />
    </StackPanel>
</ContentDialog>
