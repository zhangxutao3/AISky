<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AISky_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AISky_Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="MainPage_Loaded"
    mc:Ignorable="d">

    <Grid x:Name="RootLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RunPickerBorder.Visibility" Value="Collapsed" />
                        <Setter Target="CompactRunButton.Visibility" Value="Visible" />
                        <Setter Target="UpdateStatus.Visibility" Value="Collapsed" />
                        <Setter Target="LayerPanel.Width" Value="148" />
                        <Setter Target="LayerPanel.MaxHeight" Value="430" />
                        <Setter Target="LayerPanel.Margin" Value="0,78,8,0" />
                        <Setter Target="LayerPanel.Padding" Value="8" />
                        <Setter Target="LayerHint.Visibility" Value="Collapsed" />
                        <Setter Target="ColorBarPanel.Width" Value="232" />
                        <Setter Target="ColorBarPanel.Margin" Value="0,0,8,104" />
                        <Setter Target="TopChrome.Margin" Value="8,8,8,0" />
                        <Setter Target="TimelinePanel.Margin" Value="76,0,8,8" />
                        <Setter Target="TimelineCaption.Visibility" Value="Collapsed" />
                        <Setter Target="FirstRunCard.Width" Value="340" />
                        <Setter Target="FirstRunCard.Padding" Value="22" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RunPickerBorder.Visibility" Value="Visible" />
                        <Setter Target="CompactRunButton.Visibility" Value="Collapsed" />
                        <Setter Target="ComparePicker.Visibility" Value="Collapsed" />
                        <Setter Target="UpdateStatus.Visibility" Value="Collapsed" />
                        <Setter Target="LayerPanel.Width" Value="208" />
                        <Setter Target="LayerPanel.MaxHeight" Value="480" />
                        <Setter Target="LayerPanel.Margin" Value="0,86,12,0" />
                        <Setter Target="LayerPanel.Padding" Value="10" />
                        <Setter Target="LayerHint.Visibility" Value="Visible" />
                        <Setter Target="ColorBarPanel.Width" Value="286" />
                        <Setter Target="ColorBarPanel.Margin" Value="0,0,12,110" />
                        <Setter Target="TopChrome.Margin" Value="12,12,12,0" />
                        <Setter Target="TimelinePanel.Margin" Value="96,0,12,12" />
                        <Setter Target="TimelineCaption.Visibility" Value="Visible" />
                        <Setter Target="FirstRunCard.Width" Value="520" />
                        <Setter Target="FirstRunCard.Padding" Value="30" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1420" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RunPickerBorder.Visibility" Value="Visible" />
                        <Setter Target="CompactRunButton.Visibility" Value="Collapsed" />
                        <Setter Target="ComparePicker.Visibility" Value="Visible" />
                        <Setter Target="UpdateStatus.Visibility" Value="Visible" />
                        <Setter Target="LayerPanel.Width" Value="224" />
                        <Setter Target="LayerPanel.MaxHeight" Value="560" />
                        <Setter Target="LayerPanel.Margin" Value="0,88,18,0" />
                        <Setter Target="LayerPanel.Padding" Value="12" />
                        <Setter Target="LayerHint.Visibility" Value="Visible" />
                        <Setter Target="ColorBarPanel.Width" Value="324" />
                        <Setter Target="ColorBarPanel.Margin" Value="0,0,18,116" />
                        <Setter Target="TopChrome.Margin" Value="18,14,18,0" />
                        <Setter Target="TimelinePanel.Margin" Value="116,0,18,16" />
                        <Setter Target="TimelineCaption.Visibility" Value="Visible" />
                        <Setter Target="FirstRunCard.Width" Value="560" />
                        <Setter Target="FirstRunCard.Padding" Value="34" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <WebView2
            x:Name="MapWebView"
            AutomationProperties.HelpText="拖动可平移地图，滚轮可缩放，点击可查看格点值与多时次曲线"
            AutomationProperties.Name="气象预报地图"
            NavigationCompleted="MapWebView_NavigationCompleted" />

        <Grid
            x:Name="MapLoadingOverlay"
            Background="#F20F2831">
            <Border
                Width="300"
                Padding="28,24"
                Style="{StaticResource AISkyDarkFloatingPanelStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <ProgressRing
                        Width="38"
                        Height="38"
                        Foreground="{StaticResource AISkyAccentBrightBrush}"
                        IsActive="True" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="White"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="正在准备本地地图引擎" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="离线底图 · GPU 栅格渲染" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="TopChrome"
            Margin="18,14,18,0"
            VerticalAlignment="Top"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource AISkyFloatingPanelStyle}">
                <CommandBar
                    Background="Transparent"
                    ClosedDisplayMode="Compact"
                    DefaultLabelPosition="Collapsed"
                    IsDynamicOverflowEnabled="True">
                    <AppBarButton
                        AutomationProperties.Name="刷新本地数据状态"
                        Click="RefreshButton_Click"
                        Icon="Refresh"
                        Label="刷新"
                        ToolTipService.ToolTip="刷新本地索引" />
                    <AppBarButton
                        AutomationProperties.Name="打开补数下载"
                        Click="DownloadButton_Click"
                        Icon="Download"
                        Label="补数"
                        ToolTipService.ToolTip="补数下载" />
                    <AppBarToggleButton
                        x:Name="AutoSyncButton"
                        AutomationProperties.Name="切换自动同步"
                        Checked="AutoSyncButton_Changed"
                        Label="自动同步"
                        ToolTipService.ToolTip="每 3 小时自动检查最新起报"
                        Unchecked="AutoSyncButton_Changed">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xE895;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarSeparator />
                    <AppBarButton
                        AutomationProperties.Name="恢复全球视图"
                        Click="GlobeButton_Click"
                        Icon="Globe"
                        Label="全球"
                        ToolTipService.ToolTip="恢复全球视图" />
                    <CommandBar.SecondaryCommands>
                        <AppBarButton
                            x:Name="SyncNowButton"
                            AutomationProperties.Name="立即同步最新数据"
                            Click="SyncNowButton_Click"
                            Label="立即同步最新数据">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE895;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            AutomationProperties.Name="检查软件更新"
                            Click="CheckUpdateButton_Click"
                            Label="检查软件更新">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE777;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            Click="ImportButton_Click"
                            Icon="OpenFile"
                            Label="导入本地 NetCDF" />
                        <AppBarToggleButton
                            x:Name="DarkThemeToggle"
                            AutomationProperties.Name="切换深色界面"
                            Checked="ThemeToggle_Changed"
                            Label="深色界面"
                            Unchecked="ThemeToggle_Changed">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE706;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarButton
                            Click="SettingsButton_Click"
                            Icon="Setting"
                            Label="设置" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Border>

            <Button
                x:Name="CompactRunButton"
                Grid.Column="1"
                MinHeight="48"
                Padding="18,0"
                HorizontalAlignment="Center"
                AutomationProperties.Name="切换模型"
                Click="CompactRunButton_Click"
                Content="AISky-Energy · +3h"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" />

            <Border
                x:Name="RunPickerBorder"
                Grid.Column="1"
                MaxWidth="920"
                Padding="12,8,12,10"
                HorizontalAlignment="Center"
                Style="{StaticResource AISkyFloatingPanelStyle}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.12*" />
                        <ColumnDefinition Width="1.24*" />
                        <ColumnDefinition Width="1.34*" />
                        <ColumnDefinition Width="1.08*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="ModelPicker"
                        Grid.Column="0"
                        MinWidth="150"
                        AutomationProperties.Name="模型"
                        Header="模型"
                        SelectedIndex="0"
                        SelectionChanged="ModelPicker_SelectionChanged"
                        Style="{StaticResource AISkyCompactComboBoxStyle}">
                        <ComboBoxItem Content="AISky-Energy" />
                        <ComboBoxItem Content="AISky-SDS" />
                    </ComboBox>
                    <ComboBox
                        x:Name="InitPicker"
                        Grid.Column="1"
                        MinWidth="164"
                        AutomationProperties.Name="起报时间 UTC"
                        Header="起报（UTC）"
                        SelectionChanged="InitPicker_SelectionChanged"
                        Style="{StaticResource AISkyCompactComboBoxStyle}" />
                    <ComboBox
                        x:Name="ForecastPicker"
                        Grid.Column="2"
                        MinWidth="176"
                        AutomationProperties.Name="预报时效 UTC"
                        Header="预报（UTC）"
                        SelectionChanged="ForecastPicker_SelectionChanged"
                        Style="{StaticResource AISkyCompactComboBoxStyle}" />
                    <ComboBox
                        x:Name="ComparePicker"
                        Grid.Column="3"
                        MinWidth="142"
                        AutomationProperties.Name="模型对比"
                        Header="模型对比"
                        SelectedIndex="0"
                        Style="{StaticResource AISkyCompactComboBoxStyle}">
                        <ComboBoxItem Content="关闭对比" />
                        <ComboBoxItem Content="AISky-SDS" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border
                x:Name="UpdateStatus"
                Grid.Column="2"
                Width="242"
                MinHeight="58"
                Padding="14,9"
                VerticalAlignment="Top"
                Style="{StaticResource AISkyFloatingPanelStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        x:Name="ServiceStatusDot"
                        Width="9"
                        Height="9"
                        VerticalAlignment="Center"
                        Fill="{StaticResource AISkySuccessBrush}" />
                    <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock
                            x:Name="ServiceStatusTitle"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="本地数据服务" />
                        <TextBlock
                            x:Name="ServiceStatusText"
                            Foreground="{ThemeResource AISkyTextMutedBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="正在初始化"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border
            x:Name="LayerPanel"
            Width="224"
            MaxHeight="620"
            Margin="0,88,18,0"
            Padding="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Style="{StaticResource AISkyElevatedPanelStyle}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="4,2,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="预报图层" />
                        <TextBlock
                            Foreground="{ThemeResource AISkyTextMutedBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="点击切换当前产品" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        MinWidth="28"
                        Height="24"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AISkyCountBrush}"
                        CornerRadius="7">
                        <TextBlock
                            x:Name="LayerCountText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="0" />
                    </Border>
                </Grid>
                <ListView
                    x:Name="LayerList"
                    Grid.Row="1"
                    MaxHeight="470"
                    AutomationProperties.Name="预报图层"
                    IsTabStop="True"
                    ItemsSource="{x:Bind LayerItems}"
                    SelectionChanged="LayerList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <StaticResource ResourceKey="AISkyLayerItemStyle" />
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="54" Padding="6,5" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="34"
                                    Height="34"
                                    VerticalAlignment="Center"
                                    Background="{Binding Brush}"
                                    CornerRadius="10">
                                    <Border
                                        Margin="1"
                                        BorderBrush="#38FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="9" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="0">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{Binding Code}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource AISkyTextMutedBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="LayerHint"
                    Grid.Row="2"
                    Margin="4,0,4,2"
                    Foreground="{ThemeResource AISkyTextMutedBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="颜色和值域随产品自动更新"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border
            x:Name="ColorBarPanel"
            Width="324"
            Margin="0,0,18,116"
            Padding="14,11"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Style="{StaticResource AISkyDarkFloatingPanelStyle}">
            <StackPanel Spacing="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ColorLayerText"
                        Foreground="White"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="等待数据" />
                    <TextBlock
                        x:Name="ColorUnitText"
                        Grid.Column="1"
                        Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="" />
                </Grid>
                <Rectangle Height="8" RadiusX="4" RadiusY="4">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="ColorBarGradient" StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0" Color="#2449A5" />
                            <GradientStop Offset="0.28" Color="#27B8D0" />
                            <GradientStop Offset="0.52" Color="#F1E8C4" />
                            <GradientStop Offset="0.72" Color="#E9A62F" />
                            <GradientStop Offset="1" Color="#9F1D5A" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ColorMinimumText"
                        Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="--" />
                    <TextBlock
                        x:Name="ColorMaximumText"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="--" />
                </Grid>
            </StackPanel>
        </Border>

        <Border
            x:Name="TimelinePanel"
            Margin="116,0,18,16"
            Padding="14,11"
            VerticalAlignment="Bottom"
            Style="{StaticResource AISkyDarkFloatingPanelStyle}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PlayButton"
                    AutomationProperties.Name="播放时间序列"
                    Click="PlayButton_Click"
                    Content="&#xE768;"
                    Style="{StaticResource AISkyPlayButtonStyle}"
                    ToolTipService.ToolTip="播放预报时间序列" />
                <StackPanel
                    x:Name="TimelineCaption"
                    Grid.Column="1"
                    Width="132"
                    VerticalAlignment="Center"
                    Spacing="0">
                    <TextBlock
                        x:Name="LeadText"
                        Foreground="White"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="+3h" />
                    <TextBlock
                        x:Name="TimelineSummaryText"
                        Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="等待本地索引" />
                </StackPanel>
                <Grid Grid.Column="2" RowSpacing="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="FirstForecastText"
                            Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="--" />
                        <TextBlock
                            x:Name="ForecastTimeText"
                            Grid.Column="1"
                            Foreground="White"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="08-03 16:30 · +3h UTC" />
                        <TextBlock
                            x:Name="LastForecastText"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="--" />
                    </Grid>
                    <Slider
                        x:Name="TimelineSlider"
                        Grid.Row="1"
                        AutomationProperties.Name="预报时间轴"
                        LargeChange="8"
                        Maximum="0"
                        Minimum="0"
                        SmallChange="1"
                        StepFrequency="1"
                        Value="0"
                        ValueChanged="TimelineSlider_ValueChanged" />
                </Grid>
            </Grid>
        </Border>

        <Grid
            x:Name="FirstRunOverlay"
            Background="#F51A343D"
            Visibility="Collapsed">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <Border
                    x:Name="FirstRunCard"
                    Width="560"
                    Margin="16,32"
                    Padding="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="首次数据准备"
                    Background="#FA112A33"
                    BorderBrush="#3DFFFFFF"
                    BorderThickness="1"
                    CornerRadius="22">
                    <StackPanel Spacing="18">
                        <Border
                            Width="58"
                            Height="58"
                            HorizontalAlignment="Left"
                            Background="#2632C3D6"
                            CornerRadius="18">
                            <FontIcon
                                Foreground="{StaticResource AISkyAccentBrightBrush}"
                                FontSize="27"
                                Glyph="&#xE895;" />
                        </Border>

                        <StackPanel Spacing="7">
                            <TextBlock
                                Foreground="White"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Text="准备你的第一份预报"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                                FontSize="15"
                                LineHeight="23"
                                Text="AISky 需要至少一个完整的本地 NetCDF 时次。输入数据访问密码后，软件会从最近 3 天自动寻找最新起报；也可以直接导入已有文件。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            Padding="14,12"
                            Background="#12FFFFFF"
                            CornerRadius="10">
                            <Grid ColumnSpacing="11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing
                                    x:Name="FirstRunProgressRing"
                                    Width="22"
                                    Height="22"
                                    Foreground="{StaticResource AISkyAccentBrightBrush}"
                                    IsActive="False" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        x:Name="FirstRunStatusText"
                                        Foreground="White"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="等待开始" />
                                    <TextBlock
                                        Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="所有起报与预报时间均使用 UTC" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Spacing="7">
                            <TextBlock
                                Foreground="White"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="数据访问密码" />
                            <PasswordBox
                                x:Name="FirstRunPasswordInput"
                                MinHeight="44"
                                AutomationProperties.Name="数据访问密码"
                                MaxLength="128"
                                PasswordChanged="FirstRunPasswordInput_PasswordChanged"
                                PasswordRevealMode="Peek"
                                PlaceholderText="请输入服务器访问密码" />
                        </StackPanel>

                        <InfoBar
                            x:Name="FirstRunInfo"
                            IsClosable="False"
                            IsOpen="False"
                            Message=""
                            Severity="Informational"
                            Title="提示" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="FirstRunProbeButton"
                                MinHeight="46"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="寻找最新预报"
                                Click="FirstRunProbeButton_Click"
                                Content="寻找最新预报"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="FirstRunImportButton"
                                Grid.Column="1"
                                MinHeight="46"
                                AutomationProperties.Name="导入本地 NetCDF"
                                Click="FirstRunImportButton_Click"
                                Content="导入本地 NetCDF" />
                        </Grid>

                        <TextBlock
                            Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="数据将保存在本机；下载中断时会自动重试，不会把不完整文件加入索引。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
