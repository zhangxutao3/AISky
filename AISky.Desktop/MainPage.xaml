<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AISky_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AISky_Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="MainPage_Loaded"
    SizeChanged="RootLayout_SizeChanged"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="TimelineSlotButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource AISkyCountBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AISkyChromeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="TimelineSlotButtonSelectedStyle" TargetType="Button" BasedOn="{StaticResource TimelineSlotButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AISkyAccentBrightBrush}" />
            <Setter Property="BorderBrush" Value="#D9FFFFFF" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style x:Key="CompactTopAppBarButtonStyle" TargetType="AppBarButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CompactTopAppBarToggleButtonStyle" TargetType="AppBarToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="TopRunPickerComboBoxStyle"
            BasedOn="{StaticResource AISkyCompactComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <!-- Visual direction: airy cloud-white controls, slate typography, and restrained mint/sky iridescence over a map-first canvas. -->
    <Grid x:Name="RootLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RunPickerBorder.Visibility" Value="Collapsed" />
                        <Setter Target="CompactRunButton.Visibility" Value="Visible" />
                        <Setter Target="BrandLockup.Visibility" Value="Collapsed" />
                        <Setter Target="UpdateStatus.Visibility" Value="Collapsed" />
                        <Setter Target="RightRail.Width" Value="168" />
                        <Setter Target="RightRail.Margin" Value="0,82,8,112" />
                        <Setter Target="LayerPanel.Padding" Value="8" />
                        <Setter Target="LayerCategoryPicker.Visibility" Value="Collapsed" />
                        <Setter Target="LayerHint.Visibility" Value="Collapsed" />
                        <Setter Target="TopChrome.Margin" Value="8,20,8,0" />
                        <Setter Target="TimelinePanel.Margin" Value="8,0,8,8" />
                        <Setter Target="TimelineCaption.Visibility" Value="Collapsed" />
                        <Setter Target="FirstRunCard.Width" Value="340" />
                        <Setter Target="FirstRunCard.Padding" Value="22" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RunPickerBorder.Visibility" Value="Visible" />
                        <Setter Target="RunPickerBorder.Width" Value="560" />
                        <Setter Target="CompactRunButton.Visibility" Value="Collapsed" />
                        <Setter Target="BrandLockup.Visibility" Value="Collapsed" />
                        <Setter Target="UpdateStatus.Visibility" Value="Collapsed" />
                        <Setter Target="RightRail.Width" Value="228" />
                        <Setter Target="RightRail.Margin" Value="0,84,12,118" />
                        <Setter Target="LayerPanel.Padding" Value="10" />
                        <Setter Target="LayerCategoryPicker.Visibility" Value="Visible" />
                        <Setter Target="LayerHint.Visibility" Value="Visible" />
                        <Setter Target="TopChrome.Margin" Value="12,20,12,0" />
                        <Setter Target="TimelinePanel.Margin" Value="12,0,12,12" />
                        <Setter Target="TimelineCaption.Visibility" Value="Visible" />
                        <Setter Target="FirstRunCard.Width" Value="520" />
                        <Setter Target="FirstRunCard.Padding" Value="30" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1420" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RunPickerBorder.Visibility" Value="Visible" />
                        <Setter Target="RunPickerBorder.Width" Value="650" />
                        <Setter Target="CompactRunButton.Visibility" Value="Collapsed" />
                        <Setter Target="BrandLockup.Visibility" Value="Visible" />
                        <Setter Target="UpdateStatus.Visibility" Value="Visible" />
                        <Setter Target="RightRail.Width" Value="252" />
                        <Setter Target="RightRail.Margin" Value="0,86,18,124" />
                        <Setter Target="LayerPanel.Padding" Value="12" />
                        <Setter Target="LayerCategoryPicker.Visibility" Value="Visible" />
                        <Setter Target="LayerHint.Visibility" Value="Visible" />
                        <Setter Target="TopChrome.Margin" Value="18,20,18,0" />
                        <Setter Target="TimelinePanel.Margin" Value="18,0,18,16" />
                        <Setter Target="TimelineCaption.Visibility" Value="Visible" />
                        <Setter Target="FirstRunCard.Width" Value="560" />
                        <Setter Target="FirstRunCard.Padding" Value="34" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <WebView2
            x:Name="MapWebView"
            AutomationProperties.HelpText="拖动平移、滚轮缩放、点击查看格点曲线；左右方向键切换时次，空格播放或暂停"
            AutomationProperties.Name="气象预报地图"
            NavigationCompleted="MapWebView_NavigationCompleted" />

        <Grid
            x:Name="MapLoadingOverlay"
            Background="#F20F2831">
            <Border
                Width="300"
                Padding="28,24"
                Style="{StaticResource AISkyDarkFloatingPanelStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <ProgressRing
                        Width="38"
                        Height="38"
                        Foreground="{StaticResource AISkyAccentBrightBrush}"
                        IsActive="True" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="White"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="正在准备本地地图引擎" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="离线底图 · GPU 栅格渲染" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="TopChrome"
            Margin="18,20,18,0"
            VerticalAlignment="Top">

            <Border
                x:Name="CommandSurface"
                Height="58"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource AISkyFloatingPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        x:Name="BrandLockup"
                        Margin="10,5,3,5"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Image
                            Width="32"
                            Height="32"
                            Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                            Stretch="Uniform" />
                        <StackPanel VerticalAlignment="Center" Spacing="-2">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="AISky" />
                            <TextBlock
                                Foreground="{ThemeResource AISkyTextMutedBrush}"
                                FontSize="10"
                                Text="本地预报" />
                        </StackPanel>
                    </StackPanel>
                    <CommandBar
                        Grid.Column="1"
                        Height="48"
                        Margin="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        ClosedDisplayMode="Compact"
                        DefaultLabelPosition="Collapsed"
                        IsDynamicOverflowEnabled="True">
                    <AppBarButton
                        AutomationProperties.Name="刷新本地数据状态"
                        Click="RefreshButton_Click"
                        Icon="Refresh"
                        Label="刷新"
                        Style="{StaticResource CompactTopAppBarButtonStyle}"
                        ToolTipService.ToolTip="刷新本地索引" />
                    <AppBarButton
                        AutomationProperties.Name="打开补数下载"
                        Click="DownloadButton_Click"
                        Icon="Download"
                        Label="补数"
                        Style="{StaticResource CompactTopAppBarButtonStyle}"
                        ToolTipService.ToolTip="补数下载" />
                    <AppBarToggleButton
                        x:Name="AutoSyncButton"
                        AutomationProperties.Name="切换自动同步"
                        Checked="AutoSyncButton_Changed"
                        Label="自动同步"
                        Style="{StaticResource CompactTopAppBarToggleButtonStyle}"
                        ToolTipService.ToolTip="每 3 小时自动检查最新起报"
                        Unchecked="AutoSyncButton_Changed">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xE895;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarButton
                        AutomationProperties.Name="恢复全球视图"
                        Click="GlobeButton_Click"
                        Icon="Globe"
                        Label="全球"
                        Style="{StaticResource CompactTopAppBarButtonStyle}"
                        ToolTipService.ToolTip="恢复全球视图" />
                        <CommandBar.SecondaryCommands>
                        <AppBarButton
                            x:Name="SyncNowButton"
                            AutomationProperties.Name="立即同步最新数据"
                            Click="SyncNowButton_Click"
                            Label="立即同步最新数据">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE895;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            AutomationProperties.Name="检查软件更新"
                            Click="CheckUpdateButton_Click"
                            Label="检查软件更新">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE777;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            Click="ImportButton_Click"
                            Icon="OpenFile"
                            Label="导入本地 NetCDF" />
                        <AppBarButton
                            x:Name="TimeZoneButton"
                            AutomationProperties.Name="选择软件显示时区"
                            Click="TimeZoneButton_Click"
                            Label="显示时区 · UTC">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE823;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarToggleButton
                            x:Name="DarkThemeToggle"
                            AutomationProperties.Name="切换深色界面"
                            Checked="ThemeToggle_Changed"
                            Label="深色界面"
                            Unchecked="ThemeToggle_Changed">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE706;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarButton
                            Click="SettingsButton_Click"
                            Icon="Setting"
                            Label="设置" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                </Grid>
            </Border>

            <Button
                x:Name="CompactRunButton"
                Height="58"
                Padding="18,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                AutomationProperties.Name="切换模型"
                Click="CompactRunButton_Click"
                Content="AISky-Energy · +3h"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" />

            <Border
                x:Name="RunPickerBorder"
                Width="650"
                Height="58"
                Padding="10,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Style="{StaticResource AISkyFloatingPanelStyle}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="1.18*" />
                        <ColumnDefinition Width="1.28*" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center" RowSpacing="-1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="6,0,0,0"
                            Foreground="{ThemeResource AISkyTextMutedBrush}"
                            FontSize="10"
                            Text="模型" />
                        <ComboBox
                            x:Name="ModelPicker"
                            Grid.Row="1"
                            MinWidth="150"
                            AutomationProperties.Name="模型"
                            SelectedIndex="0"
                            SelectionChanged="ModelPicker_SelectionChanged"
                            Style="{StaticResource TopRunPickerComboBoxStyle}"
                            ToolTipService.ToolTip="模型">
                            <ComboBoxItem Content="AISky-Energy" />
                            <ComboBoxItem Content="AISky-SDS" />
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Column="1" VerticalAlignment="Center" RowSpacing="-1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="6,0,0,0"
                            Foreground="{ThemeResource AISkyTextMutedBrush}"
                            FontSize="10"
                            Text="起报时间" />
                        <ComboBox
                            x:Name="InitPicker"
                            Grid.Row="1"
                            MinWidth="164"
                            AutomationProperties.Name="起报时间"
                            SelectionChanged="InitPicker_SelectionChanged"
                            Style="{StaticResource TopRunPickerComboBoxStyle}"
                            ToolTipService.ToolTip="起报时间（当前显示时区）" />
                    </Grid>
                    <Grid Grid.Column="2" VerticalAlignment="Center" RowSpacing="-1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="6,0,0,0"
                            Foreground="{ThemeResource AISkyTextMutedBrush}"
                            FontSize="10"
                            Text="预报时间" />
                        <ComboBox
                            x:Name="ForecastPicker"
                            Grid.Row="1"
                            MinWidth="176"
                            AutomationProperties.Name="预报时效"
                            SelectionChanged="ForecastPicker_SelectionChanged"
                            Style="{StaticResource TopRunPickerComboBoxStyle}"
                            ToolTipService.ToolTip="预报时效（当前显示时区）" />
                    </Grid>
                </Grid>
            </Border>

            <Border
                x:Name="UpdateStatus"
                Width="{Binding ActualWidth, ElementName=RightRail}"
                Height="58"
                Padding="12,6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Style="{StaticResource AISkyFloatingPanelStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        x:Name="ServiceStatusDot"
                        Width="8"
                        Height="8"
                        VerticalAlignment="Top"
                        Margin="0,5,0,0"
                        Fill="{StaticResource AISkySuccessBrush}" />
                    <StackPanel Grid.Column="1" Spacing="-1">
                        <TextBlock
                            x:Name="ProductStatusText"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="等待预报产品"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="ServiceStatusTitle"
                            Foreground="{ThemeResource AISkyTextMutedBrush}"
                            FontSize="10"
                            Text="本地数据服务" />
                        <TextBlock
                            x:Name="ServiceStatusText"
                            Foreground="{ThemeResource AISkyTextMutedBrush}"
                            FontSize="10"
                            Text="正在初始化"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="RightRail"
            Width="252"
            Margin="0,86,18,124"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <Border
            x:Name="LayerPanel"
            Padding="12"
            VerticalAlignment="Stretch"
            Style="{StaticResource AISkyElevatedPanelStyle}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="4,2,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="预报图层" />
                        <TextBlock
                            x:Name="LayerContextText"
                            Foreground="{ThemeResource AISkyTextMutedBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="等待预报产品"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        MinWidth="28"
                        Height="24"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AISkyCountBrush}"
                        CornerRadius="7">
                        <TextBlock
                            x:Name="LayerCountText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="0" />
                    </Border>
                </Grid>
                <Grid Grid.Row="1" Margin="4,0" ColumnSpacing="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="LayerSearchBox"
                        Height="34"
                        MinWidth="0"
                        AutomationProperties.Name="搜索预报变量"
                        PlaceholderText="搜索变量"
                        QueryIcon="Find"
                        TextChanged="LayerSearchBox_TextChanged" />
                    <ComboBox
                        x:Name="LayerCategoryPicker"
                        Grid.Column="1"
                        Height="34"
                        MinWidth="0"
                        AutomationProperties.Name="变量分类"
                        SelectedIndex="0"
                        SelectionChanged="LayerCategoryPicker_SelectionChanged"
                        ToolTipService.ToolTip="按变量类别筛选">
                        <ComboBoxItem Content="全部" Tag="全部" />
                        <ComboBoxItem Content="基础场" Tag="基础场" />
                        <ComboBoxItem Content="水分降水" Tag="水分降水" />
                        <ComboBoxItem Content="云与辐射" Tag="云与辐射" />
                        <ComboBoxItem Content="沙尘气溶胶" Tag="沙尘气溶胶" />
                        <ComboBoxItem Content="陆面" Tag="陆面" />
                    </ComboBox>
                </Grid>
                <ListView
                    x:Name="LayerList"
                    Grid.Row="2"
                    AutomationProperties.Name="预报图层"
                    IsTabStop="True"
                    ItemsSource="{x:Bind LayerItems}"
                    SelectionChanged="LayerList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <StaticResource ResourceKey="AISkyLayerItemStyle" />
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="54" Padding="6,5" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AISkyCountBrush}"
                                    BorderBrush="#52FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Image
                                        Source="{Binding Thumbnail}"
                                        Stretch="UniformToFill" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="0">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{Binding Code}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource AISkyTextMutedBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="LayerHint"
                    Grid.Row="3"
                    Margin="4,0,4,2"
                    Foreground="{ThemeResource AISkyTextMutedBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="颜色和值域随产品自动更新"
                    TextWrapping="Wrap" />
                <ToggleSwitch
                    x:Name="WindAnimationToggle"
                    Grid.Row="4"
                    Margin="4,2,4,0"
                    AutomationProperties.Name="切换风场流线"
                    Header="风场流线"
                    IsOn="True"
                    OffContent="关闭"
                    OnContent="开启"
                    Toggled="WindAnimationToggle_Toggled" />
            </Grid>
        </Border>

        <Border
            x:Name="ColorBarPanel"
            Grid.Row="1"
            Padding="14,11"
            Style="{StaticResource AISkyFloatingPanelStyle}">
            <StackPanel Spacing="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ColorLayerText"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="等待数据" />
                    <TextBlock
                        x:Name="ColorUnitText"
                        Grid.Column="1"
                        Foreground="{ThemeResource AISkyTextMutedBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="" />
                </Grid>
                <Rectangle Height="8" RadiusX="4" RadiusY="4">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="ColorBarGradient" StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0" Color="#2449A5" />
                            <GradientStop Offset="0.28" Color="#27B8D0" />
                            <GradientStop Offset="0.52" Color="#F1E8C4" />
                            <GradientStop Offset="0.72" Color="#E9A62F" />
                            <GradientStop Offset="1" Color="#9F1D5A" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ColorMinimumText"
                        Foreground="{ThemeResource AISkyTextMutedBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="--" />
                    <TextBlock
                        x:Name="ColorMaximumText"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Foreground="{ThemeResource AISkyTextMutedBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="--" />
                </Grid>
            </StackPanel>
        </Border>
        </Grid>

        <Border
            x:Name="TimelinePanel"
            Margin="18,0,18,16"
            Padding="12,9"
            VerticalAlignment="Bottom"
            Style="{StaticResource AISkyFloatingPanelStyle}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PlayButton"
                    AutomationProperties.Name="播放时间序列"
                    Click="PlayButton_Click"
                    Content="&#xE768;"
                    Style="{StaticResource AISkyPlayButtonStyle}"
                    ToolTipService.ToolTip="播放预报时间序列" />
                <StackPanel
                    x:Name="TimelineCaption"
                    Grid.Column="1"
                    Width="118"
                    VerticalAlignment="Center"
                    Spacing="0">
                    <TextBlock
                        x:Name="LeadText"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="+3h" />
                    <TextBlock
                        x:Name="TimelineSummaryText"
                        Foreground="{ThemeResource AISkyTextMutedBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="等待本地索引" />
                </StackPanel>
                <Grid Grid.Column="2" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="FirstForecastText"
                            Foreground="{ThemeResource AISkyTextMutedBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="--" />
                        <TextBlock
                            x:Name="ForecastTimeText"
                            Grid.Column="1"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="等待预报时次" />
                        <TextBlock
                            x:Name="LastForecastText"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource AISkyTextMutedBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="--" />
                    </Grid>
                    <ScrollViewer
                        Grid.Row="1"
                        Height="58"
                        Padding="0,0,0,8"
                        AutomationProperties.Name="按日期分组的预报时间轴"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled">
                        <StackPanel
                            x:Name="TimelineDaysHost"
                            Margin="0,6,0,0"
                            Orientation="Horizontal"
                            Spacing="8" />
                    </ScrollViewer>
                </Grid>
                <Button
                    x:Name="FillSeriesButton"
                    Grid.Column="3"
                    Width="42"
                    Height="42"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="补齐当前起报预报序列"
                    Background="{ThemeResource AISkyCountBrush}"
                    BorderBrush="{ThemeResource AISkyChromeBorderBrush}"
                    Click="FillSeriesButton_Click"
                    Content="&#xE895;"
                    CornerRadius="12"
                    FontFamily="Segoe Fluent Icons"
                    Foreground="{StaticResource AISkyAccentBrush}"
                    ToolTipService.ToolTip="从数据服务器补齐当前起报的预报序列"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid
            x:Name="FirstRunOverlay"
            Background="#F51A343D"
            Visibility="Collapsed">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <Border
                    x:Name="FirstRunCard"
                    Width="560"
                    Margin="16,32"
                    Padding="34"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="首次数据准备"
                    Background="#FA112A33"
                    BorderBrush="#3DFFFFFF"
                    BorderThickness="1"
                    CornerRadius="22">
                    <StackPanel Spacing="18">
                        <Border
                            Width="58"
                            Height="58"
                            HorizontalAlignment="Left"
                            Background="#2632C3D6"
                            CornerRadius="18">
                            <FontIcon
                                Foreground="{StaticResource AISkyAccentBrightBrush}"
                                FontSize="27"
                                Glyph="&#xE895;" />
                        </Border>

                        <StackPanel Spacing="7">
                            <TextBlock
                                Foreground="White"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Text="准备你的第一份预报"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                                FontSize="15"
                                LineHeight="23"
                                Text="选择预报模型并输入数据访问密码。AISky 会从最近 3 天寻找最新起报，完整下载未来 15 天的 120 个预报时次，全部校验通过后再进入地图。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            Padding="14,12"
                            Background="#12FFFFFF"
                            CornerRadius="10">
                            <Grid ColumnSpacing="11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing
                                    x:Name="FirstRunProgressRing"
                                    Width="22"
                                    Height="22"
                                    Foreground="{StaticResource AISkyAccentBrightBrush}"
                                    IsActive="False" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        x:Name="FirstRunStatusText"
                                        Foreground="White"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="等待开始" />
                                    <TextBlock
                                        Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="下载期间保持此窗口开启；中断后可以继续重试" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Spacing="7">
                            <TextBlock
                                Foreground="White"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="首次加载模型" />
                            <ComboBox
                                x:Name="FirstRunModelPicker"
                                MinHeight="44"
                                AutomationProperties.Name="首次加载模型"
                                SelectedIndex="0">
                                <ComboBoxItem Content="AISky-Energy" />
                                <ComboBoxItem Content="AISky-SDS" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock
                                Foreground="White"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="数据访问密码" />
                            <PasswordBox
                                x:Name="FirstRunPasswordInput"
                                MinHeight="44"
                                AutomationProperties.Name="数据访问密码"
                                MaxLength="128"
                                PasswordChanged="FirstRunPasswordInput_PasswordChanged"
                                PasswordRevealMode="Peek"
                                PlaceholderText="请输入服务器访问密码" />
                        </StackPanel>

                        <InfoBar
                            x:Name="FirstRunInfo"
                            IsClosable="False"
                            IsOpen="False"
                            Message=""
                            Severity="Informational"
                            Title="提示" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="FirstRunProbeButton"
                                MinHeight="46"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="下载完整预报并进入"
                                Click="FirstRunProbeButton_Click"
                                Content="下载完整预报并进入"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="FirstRunImportButton"
                                Grid.Column="1"
                                MinHeight="46"
                                AutomationProperties.Name="导入本地 NetCDF"
                                Click="FirstRunImportButton_Click"
                                Content="导入本地 NetCDF" />
                        </Grid>

                        <TextBlock
                            Foreground="{StaticResource AISkyDarkMutedTextBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="只有同一起报的 +3h 至 +360h 共 120 个文件全部可用时才会进入地图；不完整文件不会加入索引。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
