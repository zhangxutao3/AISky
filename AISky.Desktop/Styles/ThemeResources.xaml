<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AISkyChromeBrush" Color="#F4FAFBEF" />
            <SolidColorBrush x:Key="AISkyChromeStrongBrush" Color="#FBFEFEF5" />
            <SolidColorBrush x:Key="AISkyChromeBorderBrush" Color="#5E78A4AC" />
            <SolidColorBrush x:Key="AISkyLayerHoverBrush" Color="#160BB1BD" />
            <SolidColorBrush x:Key="AISkyLayerSelectedBrush" Color="#2214B5BF" />
            <SolidColorBrush x:Key="AISkyTextMutedBrush" Color="#BA476871" />
            <SolidColorBrush x:Key="AISkyCountBrush" Color="#1717AEB8" />
            <LinearGradientBrush x:Key="AISkyStartupCoverBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FFF7FCFD" />
                <GradientStop Offset="0.52" Color="#FFDDF1F2" />
                <GradientStop Offset="1" Color="#FFB9E4E3" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AISkyStartupTitleBrush" Color="#FF17313A" />
            <SolidColorBrush x:Key="AISkyStartupSubtitleBrush" Color="#D8476871" />
            <SolidColorBrush x:Key="AISkyStartupLogoSurfaceBrush" Color="#F8FFFFFF" />
            <SolidColorBrush x:Key="AISkyStartupHaloBrush" Color="#3D54BFC3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AISkyChromeBrush" Color="#E31A2B34" />
            <SolidColorBrush x:Key="AISkyChromeStrongBrush" Color="#F020333D" />
            <SolidColorBrush x:Key="AISkyChromeBorderBrush" Color="#6B73919C" />
            <SolidColorBrush x:Key="AISkyLayerHoverBrush" Color="#287AB5C7" />
            <SolidColorBrush x:Key="AISkyLayerSelectedBrush" Color="#3A30A9C4" />
            <SolidColorBrush x:Key="AISkyTextMutedBrush" Color="#C8D8E8EE" />
            <SolidColorBrush x:Key="AISkyCountBrush" Color="#2748BCD1" />
            <LinearGradientBrush x:Key="AISkyStartupCoverBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF061A29" />
                <GradientStop Offset="0.48" Color="#FF0A3443" />
                <GradientStop Offset="1" Color="#FF0B5D66" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AISkyStartupTitleBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AISkyStartupSubtitleBrush" Color="#C8D7E7EC" />
            <SolidColorBrush x:Key="AISkyStartupLogoSurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AISkyStartupHaloBrush" Color="#3277E5D6" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AISkyChromeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AISkyChromeStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AISkyChromeBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AISkyLayerHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AISkyLayerSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AISkyTextMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AISkyCountBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AISkyStartupCoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AISkyStartupTitleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AISkyStartupSubtitleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AISkyStartupLogoSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AISkyStartupHaloBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="AISkyAccentBrush" Color="#159AAA" />
    <SolidColorBrush x:Key="AISkyAccentBrightBrush" Color="#35C5CE" />
    <SolidColorBrush x:Key="AISkyMintBrush" Color="#4DCEB5" />
    <SolidColorBrush x:Key="AISkySunBrush" Color="#F3B84B" />
    <SolidColorBrush x:Key="AISkySuccessBrush" Color="#2DB79C" />
    <SolidColorBrush x:Key="AISkyWarningBrush" Color="#E5AB36" />
    <SolidColorBrush x:Key="AISkyErrorBrush" Color="#D94D5C" />
    <SolidColorBrush x:Key="AISkyDarkChromeBrush" Color="#ED102A35" />
    <SolidColorBrush x:Key="AISkyDarkChromeBorderBrush" Color="#747696A1" />
    <SolidColorBrush x:Key="AISkyDarkMutedTextBrush" Color="#C8D7E7EC" />

    <Style x:Key="AISkyFloatingPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AISkyChromeBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AISkyChromeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style x:Key="AISkyElevatedPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AISkyChromeStrongBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AISkyChromeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="AISkyDarkFloatingPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AISkyDarkChromeBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AISkyDarkChromeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="AISkyLayerItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="AISkyCompactComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="AISkyPlayButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Background" Value="{StaticResource AISkyAccentBrightBrush}" />
        <Setter Property="Foreground" Value="#FF082B35" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
</ResourceDictionary>
